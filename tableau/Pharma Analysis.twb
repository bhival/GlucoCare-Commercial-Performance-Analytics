      <column caption='Month Filter' datatype='boolean' name='[Calculation_0652860938178560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;All&quot; THEN TRUE&#10;ELSE [month] = [Parameters].[Parameter 1]&#10;END' />
      </column>
      <column caption='Region Filter' datatype='boolean' name='[Calculation_0652860938649601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;All&quot; THEN TRUE&#10;ELSE [region] = [Parameters].[Parameter 2]&#10;END' />
      </column>
      <column caption='City Filter' datatype='boolean' name='[Calculation_0652860938878978]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;All&quot; THEN TRUE&#10;ELSE [territory_name] = [Parameters].[Parameter 3]&#10;END' />
      </column>
      <column caption='Market Share %' datatype='real' default-format='p0.0%' name='[Calculation_0652860940054531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [drug_name] = &quot;GlucoCare&quot; THEN [prescriptions] END)&#10;/&#10;SUM([prescriptions])' />
      </column>
      <column caption='Revenue (Cr)' datatype='real' default-format='*0.0&quot;Cr&quot;' name='[Calculation_0652860940279812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [drug_name] = &quot;GlucoCare&quot; THEN [prescriptions] * [unit_price_inr] END) / 10000000' />
      </column>
      <column caption='Calls per Doctor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0652860940533765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([calls_made]) / COUNTD([doctor_id])' />
      </column>
      <column caption='Price Gap %' datatype='real' default-format='p0.0%' name='[Calculation_0652860940836870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG(IF [drug_name] = &quot;GlucoCare&quot; THEN [unit_price_inr] END) - AVG(IF [drug_name] != &quot;GlucoCare&quot; THEN [unit_price_inr] END))&#10;/&#10;AVG(IF [drug_name] != &quot;GlucoCare&quot; THEN [unit_price_inr] END)' />
      </column>
      <column caption='Territory Health' datatype='string' name='[Calculation_0801501235888128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &quot;Delhi&quot; THEN &quot;North&quot;&#10;&#10;END' />
      </column>
      <column caption='Doctor Segment' datatype='string' name='[Calculation_0849811050397696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [defection_month] != &quot;&quot; THEN &quot;Lost&quot;&#10;ELSEIF [is_untapped_target] THEN &quot;Potential&quot;&#10;ELSEIF [loyalty_to_competitor] = FALSE AND [baseline_rx_potential] &gt;= 20 THEN &quot;Champion&quot;&#10;ELSE &quot;Steady&quot;&#10;END' />
      </column>
      <column caption='Total Calls (per rep)' datatype='integer' name='[Calculation_0849811126452231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([calls_made])' />
      </column>
      <column caption='Rx per Call (per rep)' datatype='real' name='[Calculation_0849811126525960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prescriptions]) / SUM([calls_made])' />
      </column>
